{
  "name": "@jellologic/starrocks-sdk",
  "type": "module",
  "exports": {
    ".": { "default": "./src/index.ts" },
    "./*": { "default": "./src/*.ts" },
    "./schema": { "default": "./src/schema/index.ts" }
  },
  "scripts": {
    "test": "bun test",
    "test:integration": "bun test --timeout 30000",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "docs:pull": "rm -rf .starrocks-docs && mkdir -p .starrocks-docs && cd .starrocks-docs && git init && git remote add origin https://github.com/StarRocks/starrocks.git && git sparse-checkout set docs/en && git pull origin main --depth 1 && echo 'StarRocks docs pulled to .starrocks-docs/docs/en'"
  },
  "dependencies": {
    "@effect/schema": "^0.75.5",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.1",
    "effect": "^3.19.15",
    "mysql2": "^3.14.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5"
  }
}
