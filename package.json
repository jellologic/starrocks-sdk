{
  "name": "@jellologic/starrocks-sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Type-safe StarRocks client with Effect.ts integration — DDL DSL, Stream Load, 2PC transactions, and materialized view management",
  "author": "jellologic",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jellologic/starrocks-sdk.git"
  },
  "homepage": "https://github.com/jellologic/starrocks-sdk#readme",
  "bugs": {
    "url": "https://github.com/jellologic/starrocks-sdk/issues"
  },
  "keywords": [
    "starrocks",
    "effect",
    "effect-ts",
    "drizzle",
    "stream-load",
    "database",
    "ddl",
    "materialized-view"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./drizzle-schema": {
      "types": "./dist/drizzle-schema.d.ts",
      "default": "./dist/drizzle-schema.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./config": {
      "types": "./dist/config/starrocks.config.d.ts",
      "default": "./dist/config/starrocks.config.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepare": "tsc -p tsconfig.build.json 2>/dev/null || true",
    "prepublishOnly": "bun run clean && bun run build",
    "lint": "biome check src/",
    "lint:fix": "biome check --fix src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test --timeout 30000",
    "docs:pull": "rm -rf .starrocks-docs && mkdir -p .starrocks-docs && cd .starrocks-docs && git init && git remote add origin https://github.com/StarRocks/starrocks.git && git sparse-checkout set docs/en && git pull origin main --depth 1 && cp -r docs/en ../._sr-docs-tmp && cd .. && rm -rf .starrocks-docs && mv ._sr-docs-tmp .starrocks-docs && echo 'StarRocks docs pulled to .starrocks-docs/'",
    "ci":"curl -fsSL https://claude.ai/install.sh | bash",
    "c": "claude --dangerously-skip-permissions"

  },
  "dependencies": {
    "@effect/schema": "^0.75.5",
    "drizzle-orm": "^0.45.1",
    "effect": "^3.19.15",
    "mysql2": "^3.14.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.1",
    "@types/bun": "^1.2.0",
    "@types/node": "^25.2.3",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.8",
    "typescript": "^5"
  }
}
